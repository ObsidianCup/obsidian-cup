{
  "redirects": [
    {
      "source": "/about.html",
      "destination": "/pages/about.html",
      "permanent": true
    },
    {
      "source": "/experiences.html",
      "destination": "/pages/experiences.html",
      "permanent": true
    },
    {
      "source": "/faq.html",
      "destination": "/pages/faq.html",
      "permanent": true
    },
    {
      "source": "/fixtures.html",
      "destination": "/pages/fixtures.html",
      "permanent": true
    },
    {
      "source": "/football.html",
      "destination": "/pages/futsal.html",
      "permanent": true
    },
    {
      "source": "/register.html",
      "destination": "/pages/register.html",
      "permanent": true
    },
    {
      "source": "/rules.html",
      "destination": "/pages/rules.html",
      "permanent": true
    },
    {
      "source": "/tournaments.html",
      "destination": "/pages/tournaments.html",
      "permanent": true
    },
    {
      "source": "/volleyball.html",
      "destination": "/pages/volleyball.html",
      "permanent": true
    },
    {
      "source": "/futsal.html",
      "destination": "/pages/futsal.html",
      "permanent": true
    },
    {
      "source": "/pages/football.html",
      "destination": "/pages/futsal.html",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.google-analytics.com https://*.googletagmanager.com; connect-src 'self' https://mpxcoipozjnqkjwtondm.supabase.co wss://mpxcoipozjnqkjwtondm.supabase.co https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; frame-src https://challenges.cloudflare.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
        },
        {
          "key": "Cross-Origin-Opener-Policy",
          "value": "same-origin"
        }
      ]
    },
    {
      "source": "/pages/(account|admin).html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ]
}
